# Leave blank to use guided demo answers; never put this in frontend variables.
OPENAI_API_KEY=''
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=25
# Comma-separated frontend origins; Vite normally proxies /api to the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional. Default is an absolute path to backend/launchpilot.db, independent of cwd.
# DATABASE_URL=sqlite:////absolute/path/to/launchpilot.db

# Milestone 3 research. Choose brave or tavily and configure its key.
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=''
TAVILY_API_KEY=''
# Defaults to OPENAI_MODEL when omitted; must support JSON Schema structured outputs.
RESEARCH_MODEL=gpt-4o-mini
RESEARCH_CACHE_HOURS=24
RESEARCH_HTTP_TIMEOUT=15
RESEARCH_MAX_SOURCES=8
RESEARCH_RETRIES=2
RESEARCH_REFRESH_MIN_SECONDS=30
# Optional absolute JSON path for additional manually verified agency domains.
# GOVERNMENT_REGISTRY_PATH=/absolute/path/to/verified-agencies.json

# Milestone 4 intelligent advisor (uses OPENAI_API_KEY; never embed keys in this file).
# ADVISOR_MODEL defaults to OPENAI_MODEL if omitted. Must support strict JSON Schema.
ADVISOR_MODEL=gpt-4o-mini
ADVISOR_TIMEOUT_SECONDS=25
ADVISOR_RETRIES=1

# Milestone 5: CORS_ORIGINS must list the actual frontend origin(s).
# Documents are stored in authenticated project storage; they are never sent to the LLM.
# VITE_API_PROXY is an optional frontend development proxy URL, not an API key.

# Authentication: leave blank for an automatically generated, ignored local secret.
# For HTTPS hosting use a stable random secret (32+ chars) and COOKIE_SECURE=true.
SESSION_SECRET=''
COOKIE_SECURE=false
